// Database schema. Prisma turns this file into SQL migrations
// (prisma/migrations) and into a fully typed client for the app.
//
// Conventions:
// - Models are PascalCase in TypeScript and snake_case in SQL (@map / @@map), so
//   raw SQL, psql and BI tools see normal Postgres names.
// - Every timestamp is `timestamptz`: it stores an absolute instant, so the
//   server's time zone can never shift the values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  // UUIDv7 rather than a counter: IDs appear in JWTs and API responses, and a
  // counter would reveal how many users exist and let anyone guess other IDs.
  // v7 starts with a timestamp, so new rows land at the end of the index like
  // a counter would, instead of at random pages like UUIDv4.
  id           String   @id @default(uuid(7)) @db.Uuid
  // Unique index: enforces one account per email and serves the login lookup.
  // The app lowercases emails before saving, so "A@x.com" and "a@x.com" collide.
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  urls          Url[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// One row per refresh token ever issued. Tokens are random strings; only their
// SHA-256 hash is stored, so a leaked copy of this table can't be used to log in.
//
// Rotation: every refresh revokes the token used and issues a new one in the
// same family. Presenting a revoked token means it was copied and used twice
// (theft, or a replayed request), so the whole family is revoked: attacker and
// victim are both logged out, and the victim signs in again with their password.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // Every token descended from one login shares a family ID.
  familyId  String    @map("family_id") @db.Uuid
  // Unique index: each refresh looks the token up by its hash.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  // Set when the token is used (rotated), on logout, or when its family is
  // revoked. Kept rather than deleted: a later reuse must be recognisable.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Revoking a family (reuse detected, or logout) updates every row by family.
  @@index([familyId])
  // The foreign key, and "sign out of all devices" for one user.
  @@index([userId])
  @@map("refresh_tokens")
}

model Url {
  // Generated by Postgres from a sequence. This number is the input to Base62
  // encoding (Phase 3): unique IDs in, unique short codes out, no collisions.
  id          BigInt    @id @default(autoincrement())
  // Unique index: the redirect hot path is `WHERE short_code = $1`, run for
  // every click. The unique constraint is also the last line of defence
  // against two rows ever getting the same code.
  shortCode   String    @unique @map("short_code") @db.VarChar(16)
  // Unique index: alias redirects look up by this column, and two users
  // claiming the same alias at the same moment hit this constraint. That gives
  // the 409 Conflict without a race between "check" and "insert".
  // NULLs don't conflict in a unique index, so URLs without an alias are fine.
  customAlias String?   @unique @map("custom_alias") @db.VarChar(64)
  // `text`, not varchar: the app limits URLs to 2048 characters, and Postgres
  // stores text and varchar identically.
  originalUrl String    @map("original_url")
  // Nullable: anonymous visitors may shorten URLs (with stricter rate limits).
  userId      String?   @map("user_id") @db.Uuid
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  // Disabled by the owner; the link stops redirecting but keeps its analytics.
  isActive    Boolean   @default(true) @map("is_active")
  // Counter kept up to date by the analytics worker (Phase 9), so URL list
  // pages show totals without a COUNT(*) over millions of click rows.
  clickCount  BigInt    @default(0) @map("click_count")
  // Soft delete. A hard delete would free the alias, and someone else could
  // claim "my-profile" and take over every place the old link was shared.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks Click[]

  // Composite index for "my URLs, newest first" (GET /api/v1/urls). The order
  // of columns matters: Postgres jumps straight to one user's rows, which are
  // already sorted by date, and reads one page. `id` breaks ties between rows
  // created in the same millisecond, which cursor pagination (Phase 7) needs.
  // It also serves the foreign key, so deleting a user doesn't scan every URL.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("urls")
}

model Click {
  id        BigInt   @id @default(autoincrement())
  urlId     BigInt   @map("url_id")
  clickedAt DateTime @default(now()) @map("clicked_at") @db.Timestamptz(3)
  // Never the raw IP. A keyed hash still lets us count unique visitors but
  // can't be reversed into a person's address (details in Phase 9).
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  referrer  String?  @db.VarChar(2048)
  // ISO 3166-1 alpha-2 code, such as "IN" or "US", from the CDN's geo header.
  country   String?  @db.Char(2)
  device    String?  @db.VarChar(16)
  browser   String?  @db.VarChar(64)
  os        String?  @db.VarChar(64)

  url Url @relation(fields: [urlId], references: [id], onDelete: Cascade)

  // Composite index for analytics: "clicks for URL X between these dates".
  // Every analytics query filters by URL first and then by time, so this order
  // makes each query a narrow range scan. It also serves the foreign key.
  @@index([urlId, clickedAt])
  @@map("clicks")
}
