# Copy to .env for local development: cp .env.example .env
# Every value here is read and validated by src/config/env.ts at startup.

NODE_ENV=development
PORT=3000
# debug | info | warn | error | silent
LOG_LEVEL=debug
# Number of reverse proxies in front of the app (nginx, ALB). 0 when running it directly.
TRUST_PROXY=0
# How long to wait for in-flight requests on shutdown before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000

# --- PostgreSQL (Phase 2) ---
# Used by docker compose to create the local database container.
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=url_shortener
POSTGRES_PORT=5432
# Used by the app and Prisma. In production this points at RDS and comes from a
# secret store, never from a committed file.
DATABASE_URL="postgresql://url_shortener:change-me@localhost:5432/url_shortener"
# Connection pool (defaults shown). The total across all instances must stay
# below the database's max_connections.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Optional. Integration tests default to DATABASE_URL with "_test" appended to the
# database name, so they never touch your development data.
# TEST_DATABASE_URL=

# --- Short links (Phase 3) ---
# Public origin that short links use. In production: your short domain.
BASE_URL=http://localhost:3000
# Secret that scrambles database IDs into unguessable short codes.
# Generate with: openssl rand -hex 32. NEVER change it after launch.
SHORT_CODE_SECRET=replace-with-output-of-openssl-rand-hex-32

# --- Redis (Phase 5) ---
# Used by docker compose to create the local Redis container.
REDIS_PASSWORD=change-me
REDIS_PORT=6379
# Used by the app. In production this points at ElastiCache (rediss:// for TLS).
REDIS_URL="redis://:change-me@localhost:6379/0"
# How long a redirect target stays cached. Longer gives more cache hits; shorter
# limits how long a stale entry can live if an invalidation is ever missed.
CACHE_TTL_SECONDS=3600
# How long "this code does not exist" is cached, which shields the database
# from repeated requests for missing codes.
CACHE_NEGATIVE_TTL_SECONDS=60
# A Redis call slower than this is treated as a cache miss, so a struggling
# Redis can never slow redirects down by more than this.
REDIS_COMMAND_TIMEOUT_MS=100
REDIS_CONNECT_TIMEOUT_MS=2000

# --- Authentication (Phase 6) ---
# Signs access tokens. Generate with: openssl rand -hex 32. Changing it
# invalidates every access token (users refresh and carry on).
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-hex-32
# Access tokens are short-lived: a stolen one works for at most this long.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh tokens: how long a user stays signed in without logging in again.
REFRESH_TOKEN_TTL_DAYS=30
