# Copy to .env for local development: cp .env.example .env
# Every value here is read and validated by src/config/env.ts at startup.

NODE_ENV=development
PORT=3000
# debug | info | warn | error | silent
LOG_LEVEL=debug
# Number of reverse proxies in front of the app (nginx, ALB). 0 when running it directly.
TRUST_PROXY=0
# How long to wait for in-flight requests on shutdown before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000

# --- PostgreSQL (Phase 2) ---
# Used by docker compose to create the local database container.
POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=change-me
POSTGRES_DB=url_shortener
POSTGRES_PORT=5432
# Used by the app and Prisma. In production this points at RDS and comes from a
# secret store, never from a committed file.
DATABASE_URL="postgresql://url_shortener:change-me@localhost:5432/url_shortener"
# Connection pool (defaults shown). The total across all instances must stay
# below the database's max_connections.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Optional. Integration tests default to DATABASE_URL with "_test" appended to the
# database name, so they never touch your development data.
# TEST_DATABASE_URL=

# --- Short links (Phase 3) ---
# Public origin that short links use. In production: your short domain.
BASE_URL=http://localhost:3000
# Secret that scrambles database IDs into unguessable short codes.
# Generate with: openssl rand -hex 32. NEVER change it after launch.
SHORT_CODE_SECRET=replace-with-output-of-openssl-rand-hex-32
